// https://www.geeksforgeeks.org/problems/merging-two-unsorted-arrays-in-sorted-order1020/1

class Solution {
    public int[] sortedMerge(int[] a, int[] b) {
        // code here
        Arrays.sort(a);
        Arrays.sort(b);
        int lenA = a.length;
        int lenB = b.length;
        int[] arr = new int[lenA + lenB];
        
        int i=0;
        int j=0;
        int k=0;
        while(i<lenA && j<lenB){
            if(a[i]<b[j]){
                arr[k]=a[i];
                i++;
            }
            else{
                arr[k]=b[j];
                j++;
            }
            k++;
        }
        while(i<lenA){
            arr[k]=a[i];
            i++;
            k++;
        }
        while(j<lenB){
            arr[k]=b[j];
            j++;
            k++;
        }
        
        return arr;
    }
}
